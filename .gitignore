# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
.python-version

# --- Test / lint / type caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Environment / secrets ---
.env
.env.*
!.env.example
# Vite mode files are shared dev config (proxy base URL), not secrets;
# anything sensitive belongs in .env*.local, which stays ignored.
!.env.development

# --- ChromaDB persistence (generated by ingestion; never commit) ---
chroma_db/

# --- Corpus: large public PDFs are fetched per README, not committed ---
# Redistribution conditions (BOE reuse terms, GuíaSalud, etc.) + repo bloat.
# Keep the folder structure via .gitkeep, ignore the binaries.
data/**/*.pdf
data/**/*.PDF
data/**/*.docx
data/**/*.xml

# --- Tiktoken / model caches (if redirected into the project) ---
.tiktoken_cache/

# --- Frontend (Vite/React) ---
frontend/node_modules/
frontend/dist/
frontend/.vite/

# --- Design scaffolding (reference only, not the product) ---
# The export/ folder is design hand-off material (Claude Design mockups, CSS,
# screenshots), not shippable code. Anchored to the repo root so ONLY this folder
# is ignored. Two files from inside it WILL be committed later, in their own final
# locations (which this rule does NOT match): config.toml → .streamlit/config.toml,
# and citara-mark.svg → assets/citara-mark.svg.
/export/

# --- Claude Code (commit shared config, ignore local-only settings) ---
.claude/settings.local.json

# --- IDE / editor ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini
